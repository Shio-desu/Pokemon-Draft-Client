@using Pokemon_Draft_Client.Services.Circuits
@inherits LayoutComponentBase
@inject CircuitHandler CircuitHandler

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <NotAuthorized>
                    <NavLink href="account/login">
                        <a>login</a>
                    </NavLink>
                </NotAuthorized>
                <Authorized>
                    <NavLink href="account/logout">
                        <a>
                            logout
                            @if (_circuitHandlerService != null)
                            {
                                @_circuitHandlerService.Username
                            }
                        </a>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private CircuitHandlerService? _circuitHandlerService;

    protected override Task OnInitializedAsync()
    {
        _circuitHandlerService  = (CircuitHandlerService)CircuitHandler;
        return base.OnInitializedAsync();
    }
}

@page "/draft/createlobby"
@using DataAccessLibrary
@using DataAccessLibrary.Interfaces
@using DataAccessLibrary.Models
@using Microsoft.AspNetCore.Authorization
@using Pokemon_Draft_Client.Services.Circuits
@rendermode InteractiveServer
@attribute [Authorize(Roles= "Administrator,User")]
@inject ISessionData SessionData
@inject IParticipationData ParticipationData
@inject IPickData PickData
@inject ILobbyUserHandlerService LobbyUserHandlerService
@inject CircuitHandler CircuitHandler

<PageTitle>Pokemon Draft</PageTitle>

<h1>Draft</h1>

<p>This component is for creating or joining a lobby.</p>

<div>
    List of open Lobbies:
    <div>
        @foreach (var lobbyUsers in LobbyUserHandlerService.LobbyUsersMap.Values)
        {
            <div>
                @lobbyUsers.Session.SessionName
                <div>
                    @foreach (var users in lobbyUsers.Usernames)
                    {
                        @users
                    }
                </div>
            </div>
        }
    </div>
</div>
<div>
    <div>
        <EditForm Model="@Session" OnValidSubmit="OnSubmitSession" FormName="SessionForm">
            <DataAnnotationsValidator/>
            <div>
                <label>Lobby Name</label>
                <InputText @bind-Value="Session.SessionName" placeholder="Draft Lobby" />
            </div>
            <div>
                <InputRadioGroup @bind-Value="Session.SessionType">
                    <label>Choose your Draft-Type:</label>
                    <div>
                        <InputRadio Value="LobbyType.Default" /><label>Default</label>
                    </div>
                    <div>
                        <InputRadio Value="LobbyType.Auction" /><label>Auction</label>
                    </div>
                </InputRadioGroup>
            </div>
            <div>
                <span>@errorMessage</span>
            </div>
            <div>
                <button type="submit">Create</button>
            </div>
        </EditForm>
    </div>
</div>


@code {
    
    [SupplyParameterFromForm]
    SessionModel Session { get; set; } = new()
    {
        // setting default session type
        SessionType = LobbyType.Default
    };
    
    private string? errorMessage;
    private CircuitHandlerService _circuitHandlerService;
    
    protected override Task OnInitializedAsync()
    {
        _circuitHandlerService  = (CircuitHandlerService)CircuitHandler;
        return Task.CompletedTask;
    }
    
    private async Task OnSubmitSession()
    {
        await LobbyUserHandlerService.CreateLobby(Session.SessionName, Session.SessionType, _circuitHandlerService.Username);
    }
}
@page "/draft"
@using DataAccessLibrary.Interfaces
@using Pokemon_Draft_Client.Services.Circuits
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles= "Administrator,User")]
@inject ILobbyUserHandlerService LobbyUserHandlerService
@inject CircuitHandler CircuitHandlerService
@inject IHttpContextAccessor HttpContextAccessor
<h3>Draft Rerouting based on if the user is already in a lobby and if the lobby has started</h3>

@code {
    
    protected override void OnInitialized()
    {
        HttpContextAccessor.HttpContext?.Response.Redirect("/draft/createlobby");
        base.OnInitialized();
    }

}
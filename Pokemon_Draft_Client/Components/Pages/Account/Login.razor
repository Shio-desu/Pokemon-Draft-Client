@page "/account/login"
@using Pokemon_Draft_Client.Models.ViewModels
@using Pokemon_Draft_Client.Services.Circuits
@using IAuthenticationService = Pokemon_Draft_Client.Services.Authentication.Interfaces.ILoginService
@using Pokemon
@inject NavigationManager NavigationManager
@inject IAuthenticationService LoginService
@inject CircuitHandler CircuitHandler

<PageTitle>Login</PageTitle>

<div>
    <div>
        <EditForm Model="@LoginView" OnValidSubmit="OnSubmitLogin" FormName="LoginForm">
            <DataAnnotationsValidator/>
            <div>
                <img src="/images/avatar.png"  alt="Generic Avatar"/>
                <h3>Login</h3>
            </div>
            <div>
                <label>Username</label>
                <InputText @bind-Value="LoginView.Username" placeholder="Username" />
                <ValidationMessage For="() => LoginView.Username" />
            </div>
            <div>
                <label>Password</label>
                <InputText @bind-Value="LoginView.Password" placeholder="Password" type="password"/>
                <ValidationMessage For="() => LoginView.Password" />
            </div>
            <div>
                <span>@_errorMessage</span>
            </div>
            <div>
                <button type="submit">Login</button>
            </div>
        </EditForm>
        <div>
            <a  href="account/register">Create new account</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public required HttpContext HttpContext { get; set; }
    
    [SupplyParameterFromForm]
    public LoginViewModel LoginView { get; set; } = new();

    private string? _errorMessage;
    private CircuitHandlerService? _circuitHandlerService;
    
    protected override Task OnInitializedAsync()
    {
        _circuitHandlerService = (CircuitHandlerService)CircuitHandler;
        return Task.CompletedTask;
    }
    
    private async Task OnSubmitLogin()
    {

        var result = await LoginService.Authenticate(LoginView.Username, LoginView.Password);

        if (result.LoginSuccessful)
        {
            _circuitHandlerService?.ChangeUsername(result.Username);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }
}
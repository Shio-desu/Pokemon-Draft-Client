@page "/account/logout"
@using Microsoft.AspNetCore.Authentication
@using Pokemon_Draft_Client.Services.Circuits
@inject NavigationManager NavigationManager
@inject CircuitHandler CircuitHandler

<h3>Successful Logout</h3>
<h4>You've successfully logged out.</h4>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }
    
    private CircuitHandlerService? _circuitHandlerService;
    
    // TODO: Login ist von hier aus nicht mehr anklickbar bis man die seite wechselt, probably wegen den notwendigen Static Renderer
    // TODO: beim logout session participation handlen
    
    protected override async Task OnInitializedAsync()
    {
        _circuitHandlerService = (CircuitHandlerService)CircuitHandler;
        await base.OnInitializedAsync();
        if (HttpContext is { User.Identity.IsAuthenticated: true })
        {
            await HttpContext.SignOutAsync();
            _circuitHandlerService?.ChangeUsername(string.Empty);
            NavigationManager.NavigateTo("/account/logout", true);
        }
    }

}